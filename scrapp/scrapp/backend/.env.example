MONGO_URI=mongodb://localhost:27017
MONGO_DB=scrapp
JWT_SECRET=replace-with-a-long-random-string
# What the phone uses to reach this server (LAN IP during development, https domain later)
PUBLIC_BASE_URL=http://192.168.1.50:8000

# sam3 = GPU server (default). grabcut = CPU-only dev fallback when no GPU is available.
SEGMENTER=sam3
# Empty = download facebook/sam3 from Hugging Face (run `hf auth login` once; the repo is gated).
SAM3_CHECKPOINT=
SAM3_CONFIDENCE=0.4
SAM3_GENERIC_PROMPTS=object,thing
SAM_DEVICE=cuda

MESHY_API_KEY=
