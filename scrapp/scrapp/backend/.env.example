MONGO_URI=mongodb://localhost:27017
MONGO_DB=scrapp
JWT_SECRET=replace-with-a-long-random-string
# What the phone uses to reach this server (LAN IP during development, https domain later)
PUBLIC_BASE_URL=http://192.168.1.50:8000

# sam2 = GPU server (default). grabcut = CPU-only dev fallback when no GPU is available.
SEGMENTER=sam2
SAM2_CHECKPOINT=checkpoints/sam2.1_hiera_large.pt
SAM2_CONFIG=configs/sam2.1/sam2.1_hiera_l.yaml
SAM_DEVICE=cuda

MESHY_API_KEY=
