MONGO_URI=mongodb://localhost:27017
MONGO_DB=scrapp
JWT_SECRET=replace-with-a-long-random-string
# What the phone uses to reach this server (LAN IP during development, https domain later)
PUBLIC_BASE_URL=http://192.168.1.50:8000

# sam3 = GPU server (default). grabcut = CPU-only dev fallback when no GPU is available.
SEGMENTER=sam3
# Empty = download facebook/sam3 from Hugging Face (run `hf auth login` once; the repo is gated).
SAM3_CHECKPOINT=
# Temporary dev option: SAM3_CHECKPOINT=checkpoints/sam3.pt with an unofficial mirror's file (see README Credits).
# Never commit weights; backend/checkpoints/ is gitignored. Official weights: facebook/sam3.
SAM3_CONFIDENCE=0.15
SAM_DEVICE=cuda

MESHY_API_KEY=
# meshy-6-lite is the cheap model; "latest" (Meshy 7.1) looks better and costs about twice as much.
MESHY_AI_MODEL=meshy-6-lite
MESHY_MAX_ACTIVE_PER_USER=2
MESHY_DAILY_LIMIT_PER_USER=10

# --- Public access (scripts/run_public.sh) ---
# Permanent hostname via a Cloudflare tunnel token; leave unset to use a random quick-tunnel URL.
# Local named tunnel (recommended): path to the tunnel's config.yml, plus its hostname.
# CLOUDFLARED_CONFIG=/home/you/.cloudflared/scrapp.yml
# Or a dashboard-managed tunnel token:
# CLOUDFLARE_TUNNEL_TOKEN=
# PUBLIC_HOSTNAME=scrapp.nmagic.dev
# Shared MongoDB Atlas instead of the local Docker one (Atlas must allow this machine's IP). Never commit this.
# MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/
# Shared key for the Scrapp 3D Studio web app (scrapp/web-app): lets it cut stickers with this server's SAM 3.
# Put the same value in web-app/.env as SCRAPP_WEBAPP_KEY. Empty = off.
WEBAPP_KEY=
