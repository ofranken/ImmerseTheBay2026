{
  "name": "meshy-3d-studio",
  "version": "1.0.0",
  "description": "Upload JPEGs, generate 3D models with Meshy AI, view and export them for three.js",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "express": "^4.21.2",
    "mongodb": "^6.22.0",
    "three": "^0.170.0"
  }
}
