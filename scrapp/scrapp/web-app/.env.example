# Get your key at https://www.meshy.ai/settings/api
MESHY_API_KEY=your_meshy_key_here
PORT=3000

# --- MongoDB image source (optional) ---
# Defaults match the Scrapp backend: db "scrapp", GridFS bucket "media",
# sources "captures" (original_file_id) and "stickers" (image_file_id).
MONGO_URI=mongodb://localhost:27017
MONGO_DB=scrapp
MONGO_BUCKET=media

# Optional: point at other collections. Each source = a collection whose docs
# hold an ObjectId reference to a file in the GridFS bucket above.
# MONGO_SOURCES_JSON={"photos":{"label":"Photos","collection":"photos","fileField":"file_id","titleFields":["title"],"dateField":"created_at"}}

# Required to open the studio from the internet (HTTP Basic password). Without it only localhost works.
# STUDIO_PASSWORD=choose-a-long-passphrase

# --- Dummy model (prototyping without spending Meshy credits) ---
# The "Dummy model" checkbox in the UI does this per request; this forces it for everything.
# MESHY_DUMMY=1

# --- Saving finished models to MongoDB ---
# Finished models are written like the Scrapp backend does: GLB + thumbnail into the
# GridFS bucket (metadata.kind "mesh" / "mesh_thumb") and a doc in the "meshes" collection.
# MONGO_SAVE_MESHES=1        # set 0 to keep models local only
# MONGO_SAVE_DUMMIES=0       # set 1 to also save dummy models (flagged dummy: true)
# MONGO_OWNER_ID=            # users._id to own models made from uploads (Mongo images keep their owner)

# --- Sticker cutting (SAM 3, same model as the app) ---
# The Scrapp backend runs SAM 3 on its GPU; the web app calls its /webapp routes.
# Set the same random value here and as WEBAPP_KEY in backend/.env, then restart both.
SCRAPP_API_URL=http://localhost:8000
# SCRAPP_WEBAPP_KEY=
